<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Core permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notification permissions (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Usage stats (for context awareness - requires PACKAGE_USAGE_STATS) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Device info -->
    <uses-permission android:name="android.permission.GET_PACKAGE_SIZE" />
    <uses-permission android:name="android.permission.READ_DEVICE_CONFIG"
        tools:ignore="ProtectedPermissions" />

    <!-- Audio capture for audio-reactive visualization -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- OpenGL ES 3.0 for neural visualization -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="false" />

    <application
        android:name="com.aihos.SAIHOSApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.SAIHOS"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name="com.aihos.ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SAIHOS">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Notification action broadcast receiver -->
        <receiver
            android:name="com.aihos.broadcast.NotificationActionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.aihos.notification.DISMISSED" />
                <action android:name="com.aihos.notification.CLICKED" />
                <action android:name="com.aihos.notification.ACTION" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
